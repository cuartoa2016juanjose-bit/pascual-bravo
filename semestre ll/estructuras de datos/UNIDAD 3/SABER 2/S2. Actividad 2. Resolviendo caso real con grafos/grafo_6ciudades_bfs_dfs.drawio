    </mxCell>
    <mxCell id="bfs_table" value="
Paso | Visitado   | Cola
-----|------------|----------------------------
 1   | Bogotá     | [Medellín, Cali, Bucaramanga]
 2   | Medellín   | [Cali, Bucaramanga, Barranquilla]
 3   | Cali       | [Bucaramanga, Barranquilla, Cartagena]
 4   | Bucaramanga| [Barranquilla, Cartagena]
 5   | Barranquilla| [Cartagena]
 6   | Cartagena  | []

Resultado: Bogotá → Medellín → Cali →
           Bucaramanga → Barranquilla → Cartagena" style="text;html=0;strokeColor=#1e88e5;fillColor=#f5f9ff;align=left;fontSize=11;fontFamily=Courier New;rounded=1;whiteSpace=wrap;verticalAlign=top;" vertex="1" parent="1">
