    <!-- ======================== BFS TABLE ======================== -->
    <mxCell id="bfs_title" value="🔵 Recorrido BFS (Cola) — desde Bogotá" style="text;html=1;strokeColor=none;fillColor=#dae8fc;align=center;fontSize=13;fontStyle=1;fontColor=#1e88e5;rounded=1;" vertex="1" parent="1">
