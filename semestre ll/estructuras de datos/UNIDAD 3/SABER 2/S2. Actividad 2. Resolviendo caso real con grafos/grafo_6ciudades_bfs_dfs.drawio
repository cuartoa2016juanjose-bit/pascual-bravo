    <mxCell id="dfs_table" value="
Paso | Visitado    | Pila
-----|-------------|----------------------------
 1   | Bogotá      | [Medellín, Cali, Bucaramanga]
 2   | Bucaramanga | [Medellín, Cali, Barranquilla]
 3   | Barranquilla| [Medellín, Cali, Cartagena]
 4   | Cartagena   | [Medellín, Cali]
 5   | Cali        | [Medellín]
 6   | Medellín    | []

Resultado: Bogotá → Bucaramanga → Barranquilla
           → Cartagena → Cali → Medellín" style="text;html=0;strokeColor=#f9a825;fillColor=#fffde7;align=left;fontSize=11;fontFamily=Courier New;rounded=1;whiteSpace=wrap;verticalAlign=top;" vertex="1" parent="1">
