        <mxCell id="ap3" value="&lt;b&gt;Compiladores&lt;/b&gt;&lt;br&gt;Árbol sintáctico (AST)&lt;br&gt;Analiza estructura del código" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#b85450;fontColor=#333333;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="1420" width="200" height="80" as="geometry" />
