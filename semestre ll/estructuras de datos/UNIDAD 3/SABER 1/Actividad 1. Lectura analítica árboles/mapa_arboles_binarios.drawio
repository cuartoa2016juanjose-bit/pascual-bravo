        <mxCell id="ap6" value="&lt;b&gt;Interfaces GUI&lt;/b&gt;&lt;br&gt;DOM en HTML&lt;br&gt;Menús, paneles de navegación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#b85450;fontColor=#333333;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="660" y="1540" width="200" height="80" as="geometry" />
