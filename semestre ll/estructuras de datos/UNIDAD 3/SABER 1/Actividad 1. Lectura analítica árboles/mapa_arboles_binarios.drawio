        <mxCell id="ap5" value="&lt;b&gt;Motores de búsqueda&lt;/b&gt;&lt;br&gt;Categorías y filtros&lt;br&gt;Tiendas en línea" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#b85450;fontColor=#333333;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="1540" width="200" height="80" as="geometry" />
