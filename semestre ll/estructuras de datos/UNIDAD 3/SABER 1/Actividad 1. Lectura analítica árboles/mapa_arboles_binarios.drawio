        <mxCell id="ap2" value="&lt;b&gt;Sistemas de archivos&lt;/b&gt;&lt;br&gt;Carpetas y subcarpetas&lt;br&gt;Windows, Linux, macOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#b85450;fontColor=#333333;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="1420" width="200" height="80" as="geometry" />
